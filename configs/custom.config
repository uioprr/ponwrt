# ============================================================
# PonWrt 自定义编译配置 - 叠加层
# 目标平台: an7583 (Airoha) / 设备 Nokia XG-040G-MF
# 用法: 在 an7583.config + release.config 之后最后合并，用于覆盖与追加
#
# 需求: OpenClash + WireGuard + DDNS(Cloudflare)，不再额外增加其他插件
#
# 说明1: 仅声明顶层目标包即可。OpenWrt 的 DEPENDS "+dep" 在
#        scripts/package-metadata.pl 中会生成 kconfig "select"，
#        make defconfig 时自动拉齐依赖，无需手工枚举。
# 说明2: 本文件按 OpenWrt kconfig 语法解析，"CONFIG_X is not set" 形式
#        即使前面带井号也依然生效（会被解析为关闭该包），不能当作注释使用。
# ============================================================

# ---------- 1. OpenClash ----------
CONFIG_PACKAGE_luci-app-openclash=y

# ---------- 2. WireGuard ----------
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# ---------- 3. DDNS + Cloudflare ----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

# ---------- 4. 裁剪：关闭 release.config 带入的 UPnP ----------
# 下面这行带井号是 OpenWrt kconfig 表达"关闭"的唯一标准写法，不是注释。
# 若之后想保留 UPnP，必须整行删除（再叠加井号依然算关闭）。
# CONFIG_PACKAGE_luci-app-upnp is not set
