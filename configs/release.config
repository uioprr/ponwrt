CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---- uioprr 定制：OpenClash + WireGuard + DDNS(Cloudflare) ----
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
# ddns-go：Web UI 版 DDNS 客户端，支持 Cloudflare API Token 与泛域名（*.domain）
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
# 开启 UPnP（本次定制）
CONFIG_PACKAGE_luci-app-upnp=y

# ---- 本次定制：Airoha NPU 状态页 + ONU 配置栈（naoki66 fork）----
CONFIG_PACKAGE_luci-app-airoha-npu=y
# luci-app-pon 已由 fork 改名为 luci-app-onu（kconfig 标准关闭语法）
# CONFIG_PACKAGE_luci-app-pon is not set
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y

# ---- 默认开启 nftables flow offload（PPE 硬件转发），OpenClash 启用时自动跳过 ----
CONFIG_PACKAGE_ponwrt-defaults=y
